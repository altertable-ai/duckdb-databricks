# name: test/sql/databricks/secret.test
# description: secret parameters are checked when the secret is created
# group: [databricks]

require databricks

statement error
CREATE SECRET dbx (TYPE databricks, WAREHOUSE_ID 'wh', TOKEN 't');
----
HOST

statement error
CREATE SECRET dbx (TYPE databricks, HOST 'example.databricks.com', TOKEN 't', CLIENT_ID 'id', CLIENT_SECRET 'sec');
----
TOKEN cannot be combined with CLIENT_ID

statement error
CREATE SECRET dbx (TYPE databricks, HOST 'example.databricks.com', CLIENT_ID 'id');
----
CLIENT_SECRET

statement error
CREATE SECRET dbx (TYPE databricks, HOST 'example.databricks.com');
----
Specify TOKEN

statement ok
CREATE SECRET dbx (TYPE databricks, HOST 'example.databricks.com', WAREHOUSE_ID 'wh', TOKEN 'super-secret-token');

query I
SELECT secret_string LIKE '%super-secret-token%' FROM duckdb_secrets() WHERE name = 'dbx';
----
false

query I
SELECT secret_string LIKE '%redacted%' FROM duckdb_secrets() WHERE name = 'dbx';
----
true
