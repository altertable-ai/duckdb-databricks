# name: test/sql/live/dml.test
# description: update, delete, and truncate on a real warehouse
# group: [live]

require-env DATABRICKS_HOST

require-env DATABRICKS_WAREHOUSE_ID

require-env DATABRICKS_TEST_CATALOG

require-env DATABRICKS_TOKEN

require-env DATABRICKS_TEST_SCHEMA

require databricks

set ignore_error_messages __no_such_error__

statement ok
CREATE SECRET dbx (
	TYPE databricks,
	HOST '${DATABRICKS_HOST}',
	WAREHOUSE_ID '${DATABRICKS_WAREHOUSE_ID}',
	TOKEN '${DATABRICKS_TOKEN}',
	CATALOG '${DATABRICKS_TEST_CATALOG}'
);

statement ok
ATTACH '' AS db (TYPE databricks, SECRET dbx, SCHEMA '${DATABRICKS_TEST_SCHEMA}');

statement ok
CREATE TABLE db.changes (id INTEGER, region VARCHAR, amount INTEGER);

statement ok
CREATE TABLE db.other (id INTEGER);

statement ok
INSERT INTO db.changes VALUES (1, 'east', 10), (2, 'West', 20), (3, 'north', 30);

statement ok
INSERT INTO db.other VALUES (1);

query I
UPDATE db.changes SET region = 'south' WHERE id = 1;
----
1

query I
SELECT region FROM db.changes WHERE id = 1;
----
south

query I
UPDATE db.changes SET region = lower(region) WHERE id = 2;
----
1

query I
SELECT region FROM db.changes WHERE id = 2;
----
west

query I
UPDATE db.changes SET amount = amount + 1 WHERE id = 1 AND region LIKE 's%';
----
1

query I
SELECT amount FROM db.changes WHERE id = 1;
----
11

statement error
UPDATE db.changes SET region = 'z' FROM db.other WHERE db.changes.id = other.id;
----
MERGE

statement error
UPDATE db.changes SET region = md5(region) WHERE id = 1;
----
MERGE

statement error
DELETE FROM db.changes WHERE id IN (SELECT id FROM db.other);
----
MERGE

statement error
DELETE FROM db.changes RETURNING id;
----
MERGE

query I
SELECT region FROM db.changes WHERE id = 1;
----
south

query I
DELETE FROM db.changes WHERE id = 3;
----
1

query I
SELECT count(*) FROM db.changes;
----
2

statement ok
ATTACH '' AS ro (TYPE databricks, SECRET dbx, SCHEMA '${DATABRICKS_TEST_SCHEMA}', READ_ONLY);

statement error
DELETE FROM ro.changes WHERE id = 1;
----
read-only

statement ok
TRUNCATE TABLE db.changes;

query I
SELECT count(*) FROM db.changes;
----
0

statement ok
DROP TABLE db.changes;

statement ok
DROP TABLE db.other;
